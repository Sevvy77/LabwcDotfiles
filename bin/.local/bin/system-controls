#!/bin/sh
# System Controls: Bluetooth (bluetui), Networks (nmrs-tui), Volume
# Control (wiremix) and Bar (crimson-bar-outputs: which monitors show the
# bar) as tabs of one zellij session. Opened by Super+o and
# crimson-controls.desktop, in an alacritty window of class crimson-controls.
# Alt+j/k/l/; goes to a tab (the same keys as workspaces, which are
# Super+Ctrl+j/k/l/;), Alt+←/→ or a click switches tabs; Alt+q quits.
cfg="$HOME/.config/zellij/system-controls.kdl"
layouts="$HOME/.config/zellij/layouts"

# The tab bar is the zjstatus plugin (installed by install.sh), which needs
# a one-time permission. Its prompt can't take keys inside the hub, so
# until it's been allowed, open zjstatus on its own first: press y, then
# Alt+q to carry on.
perms="${XDG_CACHE_HOME:-$HOME/.cache}/zellij/permissions.kdl"
if ! grep -qs "zjstatus.wasm" "$perms"; then
    zellij --config "$cfg" --new-session-with-layout "$layouts/zjstatus-permissions.kdl"
fi

exec zellij --config "$cfg" --new-session-with-layout "$layouts/system-controls.kdl"
