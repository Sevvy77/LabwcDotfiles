# Run by labwc (with sh) when it starts, whether from a TTY or a display
# manager such as GDM.

# Per-machine settings, such as display scaling, go in autostart.local next
# to this file. It isn't part of the repo. Example:
#   wlr-randr --output eDP-1 --scale 1.4
[ -f ~/.config/labwc/autostart.local ] && . ~/.config/labwc/autostart.local

# Give user services the display, then start the session target (see
# ~/.config/systemd/user/labwc-session.target). Without it xdg-desktop-portal
# never starts, and libadwaita apps such as Nautilus come up light.
if command -v dbus-update-activation-environment >/dev/null; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
else
  systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
fi
systemctl --user start labwc-session.target

# Wallpaper: ~/Pictures/wallpaper.png if there is one, else the theme colour.
if [ -f ~/Pictures/wallpaper.png ]; then
  swaybg -i ~/Pictures/wallpaper.png -m fill &
else
  swaybg -c '#1f1416' &
fi

# Password prompts for apps that need admin rights (blueman, mounting drives
# in Nautilus). The agent lives in a different place on each distro.
for agent in /usr/libexec/polkit-mate-authentication-agent-1 \
             /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do
  if [ -x "$agent" ]; then "$agent" & break; fi
done

sfwbar &
alacritty &
# Debian's Firefox is firefox-esr.
for browser in firefox firefox-esr; do
  if command -v "$browser" >/dev/null; then "$browser" & break; fi
done
