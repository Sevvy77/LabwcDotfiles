<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <theme>
    <name>OB-Crimson-Dark</name>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-k">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="swaylock -i ~/Pictures/wallpaper.png --scaling fill"/>
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-p">
      <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png'" />
    </keybind>
    <keybind key="C-A-BackSpace">
      <action name="Exit" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +5%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>
</labwc_config>
