<labwc_config>
  <!-- Named rather than numbered, so sfwbar's pager shows "1" instead of
       "Workspace 1" -->
  <desktops>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>
  <keyboard>
    <default />
    <!-- The W- prefix refers to the Super key -->
    <keybind key="W-Return" onRelease="yes">
      <action name="Execute" command="alacritty" />
    </keybind>
    <keybind key="XF86Calculator" onRelease="yes">
      <action name="Execute">
        <command>galculator</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>brightnessctl set +5%</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>brightnessctl set 5%-</command>
      </action>
    </keybind>
    <keybind key="W-j">
      <action name="Close" />
    </keybind>
    <keybind key="W-l" onRelease="yes">
      <action name="Execute" command="gtklock" />
    </keybind>
    <keybind key="W-semicolon" onRelease="yes">
      <action name="Execute" command="nautilus" />
    </keybind>
    <keybind key="W-n" onRelease="yes">
      <action name="Execute" command="wdisplays" />
    </keybind>
    <keybind key="W-h" onRelease="yes">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-p" onRelease="yes">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" - | wl-copy'</command>
      </action>
    </keybind>
    <keybind key="W-k" onRelease="yes">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Exit" />
    </keybind>
    <keybind key="W-C-j">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-C-k">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-C-l">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-C-semicolon">
      <action name="GoToDesktop" to="4" />
    </keybind>
  </keyboard>
  <theme>
    <name>OB-Crimson-Dark</name>
  </theme>
</labwc_config>
