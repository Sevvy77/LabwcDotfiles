# sfwbar: bottom panel for labwc, Crimson Dark
# Left to right: clock, window tabs, CPU and memory graphs, tray.

Set Term = "alacritty"   # cpu/memory graphs open `top` in this on click

include("winops.widget") # right-click menu on a tab
include("cal.widget")    # calendar popup for the clock

# Opens the calendar on the current month. This is beta16's XCalPopUp, copied
# here because beta17's cal.widget no longer provides it (it keeps its
# functions private and builds the calendar itself when the popup opens).
# Works on both: beta17 ignores the Evals and XCalInit, PopUp "XCal" is shared.
Function("ClockPopUp") {
  Eval "XCalYear", time("%Y")
  Eval "XCalMonth", time("%m")
  Eval "XCalDay", time("%d")
  Function "XCalInit"
  PopUp "XCal"
}

# sfwbar 1.0~beta16 doesn't draw the bar at all without a switcher
# section, even though nothing on labwc opens the switcher. Keep it.
switcher { cols = 5 }

# No "layer" line: the bar sits on the default (top) layer. beta17 rejects an
# unknown value such as "desktop" and drops the widget that follows (the clock).
layout {
  mirror = "*"

  grid {
    css = "* { padding: 0 5px; }"
    action = Function "ClockPopUp"
    label { value = Time("%H:%M") }
  }

  taskbar {
    css = "* { -GtkWidget-hexpand: true; -FlowGrid-column-homogeneous: true; }"
    rows = 1
    icons = true
    labels = true
    group icons = true
    group labels = true
    sort = true
    action[RightClick] = Menu "winops"
    action[MiddleClick] = Close
    action[Drag] = Focus
  }

  include("cpu.widget")
  include("memory.widget")

  tray { rows = 1 }

  # Left out on purpose: bluez.widget, network-module.widget, volume.widget.
  # In this sfwbar version their "channel ack" handlers call
  # g_main_context_invoke_full() from the main thread, which GLib runs
  # synchronously, so they recurse forever: 100% CPU, growing memory, and a
  # main loop that never idles long enough to draw anything else.
}

#CSS

/* Palette */
@define-color crimson_bg #140C0D;
@define-color crimson_text #E8D5D0;
@define-color crimson_bright #F5E9E6;
@define-color crimson #C0303A;
@define-color crimson_hot #E5484D;

/* Names the bundled widgets (cal.widget) expect */
@define-color theme_bg_color @crimson_bg;
@define-color theme_text_color @crimson_text;
@define-color borders @crimson;
@define-color border @crimson;

* { -GtkWidget-vexpand: true; }

window#sfwbar {
  -GtkWidget-direction: bottom;
  background-color: alpha(@crimson_bg, 0.85);
}

grid#layout {
  -GtkWidget-direction: right;
  min-height: 31px;
}

grid { margin: 0; padding: 0; }

label {
  font: 12px Sans;
  color: @crimson_text;
  text-shadow: none;
}

#hidden { -GtkWidget-visible: false; }

/* Strip GTK's default button and icon decoration */
button, image {
  background: none;
  border-image: none;
  box-shadow: none;
}
button { outline-style: none; }
image {
  min-width: 18px;
  min-height: 18px;
  border: none;
  -gtk-icon-shadow: none;
}

/* Window tabs */
button#taskbar_item {
  -GtkWidget-hexpand: false;
  padding: 0 5px;
  border-radius: 4px;
  border-color: alpha(@crimson, 0.3);
  background-color: alpha(@crimson, 0.12);
}
button#taskbar_item:hover {
  border-color: alpha(@crimson_hot, 0.6);
  background-color: alpha(@crimson_hot, 0.25);
}
button#taskbar_item.focused {
  border-color: rgba(0, 0, 0, 0.4);
  background-color: @crimson;
}
button#taskbar_item image { min-width: 24px; min-height: 24px; }
button#taskbar_item label { -GtkWidget-hexpand: false; padding-left: 5px; }
button#taskbar_item.focused label { color: @crimson_bright; }

/* CPU and memory */
chart#cpu_chart {
  min-width: 9px;
  margin: 2px;
  border: 1px solid @crimson;
  background: rgba(127, 127, 127, 0.3);
  color: @crimson_hot;
}
progressbar#memory {
  -GtkWidget-direction: top;
  min-width: 9px;
  margin: 2px;
  border: 1px solid @crimson;
}
progressbar#memory trough {
  min-width: 9px;
  min-height: 2px;
  border: none;
  border-radius: 0;
  background: rgba(127, 127, 127, 0.3);
}
progressbar#memory progress {
  -GtkWidget-hexpand: true;
  min-width: 9px;
  margin: 0;
  border: none;
  border-radius: 0;
  background-color: @crimson_hot;
}

/* Tray: hide icons of apps that report themselves passive */
button#tray_item {
  -GtkWidget-valign: center;
  margin: 0;
  padding: 0 1px 0 0;
  border: none;
}
button#tray_item.passive { -GtkWidget-visible: false; }

/* Tab right-click menu, tooltips */
menu {
  padding: 2px;
  border: 2px solid @crimson;
  background-color: @crimson_bg;
}
menuitem { padding: 2px; color: @crimson_text; }
menuitem:hover { background-color: @crimson; }
menuitem:hover label { color: @crimson_bright; }
menu image { padding-right: 5px; }
tooltip { background-color: @crimson_bg; }
